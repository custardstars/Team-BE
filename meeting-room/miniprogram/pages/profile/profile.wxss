/* profile.wxss */
.profile {
  padding: 20px;
  background-color: #ffffff;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
}

image {
  border-radius: 50%;
  width: 120px;
  height: 120px;
  object-fit: cover;
  margin-bottom: 15px;
}

text {
  font-size: 22px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

input {
  width: 100%;
  padding: 12px;
  margin-top: 10px;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-size: 16px;
  height: 50px;
  box-sizing: border-box;
}

input:focus {
  border-color: #1aad19;
  outline: none;
}

button {
  width: 100%;
  padding: 12px;
  margin-top: 280px;
  background-color: #1aad19;
  color: #ffffff;
  font-size: 16px;
  border-radius: 5px;
  border: 20px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

button:hover {
  background-color: #0d8e11;
}