<view class="order-container">
  <view class="tab-container">
    <view class="tab" data-tab="all" bindtap="onTabChange">
      <text>全部</text>
    </view>
    <view class="tab" data-tab="reserved" bindtap="onTabChange">
      <text>已预约</text>
    </view>
    <view class="tab" data-tab="completed" bindtap="onTabChange">
      <text>已完成</text>
    </view>
    <view class="tab" data-tab="subscribed" bindtap="onTabChange">
      <text>已订阅</text>
    </view>
  </view>

  <view class="order-list">
    <!-- 遍历显示当前订单数据 -->
    <block wx:for="{{currentOrders}}" wx:key="index">
      <view class="order-item">
        <view class="order-info">
          <text class="order-room">会议室: {{item.room_name}}</text>
          <text class="order-date">日期: {{item.date}}</text>
          <text class="order-time">时间段: {{item.time_slots}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
