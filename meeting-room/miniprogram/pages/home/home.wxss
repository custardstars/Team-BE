/* 页面整体布局 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
}

/* 顶部日期导航栏 */
.date-nav {
  display: flex;
  justify-content: space-between; /* 两端对齐 */
  padding: 0; /* 去除 padding */
  margin: 0; /* 去除 margin */
  background-color: #f2f2f2;
  width: 100%; /* 撑满整个宽度 */
}

.date-item {
  text-align: center;
  flex: 1;
  color: #666;
  padding-top: 8px;
  padding-bottom: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-item.selected {
  color: #ffffff;
  /* font-size: 20; */
  background-color: #007aff;
  /* font-weight: bold; */
  border-radius: 3px;
}

.date-item text {
  display: block;
  font-size: 14px;
  margin-bottom: 2px; /* 增加下边距，确保日期和星期几间距更自然 */
}

/* 时间段列表 */
.time-list {
  flex: 1;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f0f0;
  height: 25px;
}

.time {
  font-size: 16px;
  color: #333;
}

.status {
  font-size: 14px;
  color: #999;
}

/* 确定按钮 */
.confirm-button {
  padding: 20px;
  text-align: center;
}

button {
  background-color: #007aff;
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 16px;
  border: none;
}

/* 弹出窗口样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 8px;
  overflow: hidden;
  padding: 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ccc;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
}

.modal-close {
  width: 90%; /* 调整按钮宽度 */
  max-width: 100px; /* 设置最大宽度 */
  margin: 5px 0; /* 调整间距 */
  padding: 8px; /* 调整按钮内边距 */
  text-align: center;
  background-color: #6cadf3;
  color: rgb(253, 253, 253);
  border: none;
  border-radius: 5px;
  font-size: 12px; /* 调整按钮字体大小 */
  cursor: pointer;
}

.modal-body {
  padding: 20px 0;
}

/* 新增样式：空闲和占用会议室分左右两边 */
.rooms-container {
  display: flex;
  justify-content: space-between;
}

.free-rooms, .occupied-rooms {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
}

.room-button {
  width: 90%; /* 调整按钮宽度 */
  max-width: 100px; /* 设置最大宽度 */
  margin: 5px 0; /* 调整间距 */
  padding: 8px; /* 调整按钮内边距 */
  text-align: center;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 5px;
  font-size: 12px; /* 调整按钮字体大小 */
  cursor: pointer;
}
