/* pages/booking/booking.wxss */
/* 页面整体布局 */
.container {
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  height: 100vh;
}

/* 顶部日期栏 */
.date-nav {
  display: flex;
  justify-content: space-between;
  background-color: #d6d6d6;
  padding: 0;
  margin: 0;
}

.date-item {
  flex: 1;
  text-align: center;
  color: rgb(0, 0, 0);
  padding: 8px 0;
}

.date-item.selected {
  background-color: #aec4ff;
  /* font-weight: bold; */
}


/* 时间段选择 */
.section-title {
  margin: 10px 0;
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.time-grid {
  /* border: 10px; */
  height: 220px;
  margin-top: 20px;
  margin-bottom: 30px;
  /* background-color: blueviolet; */
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 10px;
}

.time-item {
  width: 30%;
  text-align: center;
  margin: 5px 0;
  padding: 8px 0;
  border: 1px solid #000000;
  border-radius: 8px;
  color: #000000;
}
.time-item.reserved {
  background-color: #d6f5ad;
  border: 1px solid #2b2b2b;
  color: rgb(0, 0, 0);
}
.time-item.selected {
  background-color: #c2c2c2;
  border: 1px solid #2b2b2b;
  color: rgb(0, 0, 0);
}
.time-item.disabled {
  background-color: #474747;
  color: #fff;
}
.time-item.subscribed {
  background-color: #82c2fd;
  color: rgb(49, 49, 49);
}
.time-item.disabled-selected {
  background-color: #ff5858;
  color: #ffffff;
  border: 1px solid #ff5858;
}

/* 基础预约信息 */
.form-section {
  margin-right: 20px;
  margin-top: 20px;
  width: 300px;
  height: 280px;
  padding: 0 10px;
  /* background-color: blueviolet; */
}
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ccc;
  padding: 10px 0;
  font-size: 16px;
}

.form-item input {
  border: none;
  outline: none;
  text-align: right;
  font-size: 14px;
}

/* 确定按钮 */
.confirm-btn {
  width: 80%;
  margin: 20px auto;
  background-color: #d1d1d1;
  color: rgb(58, 47, 47);
  padding: 10px 0;
  border-radius: 8px;
  text-align: center;
  font-size: 16px;
}

/* 图标样式 */
.help-icon {
  position: relative;
  top: -10px;
  left: 100px;
  width: 60px;
  height: 60px;
}

.help-icon image {
  width: 100%;
  height: 100%;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}
.modal-content {
  background-color: #fff;
  width: 80%;
  padding: 20rpx;
  height: 300px;
  border-radius: 10rpx;
  text-align: center;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.modal-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}
.modal-btn {
  background-color: #007aff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}