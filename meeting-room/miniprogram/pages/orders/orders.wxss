.tabs {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.tab {
  padding: 10px 20px;
  text-align: center;
  cursor: pointer;
}

.tab.active {
  background-color: #007aff;
  color: white;
}

.order-list {
  padding: 10px;
}

.order-item {
  padding: 15px;
  border-bottom: 1px solid #ddd;
}

.order-item text {
  display: block;
  margin-bottom: 5px;
}
