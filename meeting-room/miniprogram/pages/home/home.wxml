<view class="container">
  <!-- 顶部日期导航栏 -->
  <view class="date-nav">
    <block wx:for="{{weekDates}}" wx:key="index">
      <view 
        class="date-item {{selectedDateIndex === index ? 'selected' : ''}}" 
        bindtap="onDateSelect" 
        data-index="{{index}}">
        <text>{{item.date}}</text>
        <text>{{item.day}}</text>
      </view>
    </block>
  </view>

  <!-- 可上下拖动的时间段列表 -->
  <scroll-view scroll-y class="time-list">
    <block wx:for="{{timeSlots}}" wx:key="index">
      <view 
        class="time-item" 
        bindtap="onTimeSlotSelect" 
        data-index="{{index}}">
        <text class="time">{{item.time}}</text>
        <text class="status">{{item.status}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 弹出窗口 -->
  <view wx:if="{{showModal}}" class="modal">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">会议室详情</text>
        <button class="modal-close" bindtap="closeModal">关闭</button>
      </view>
      <view class="modal-body">
        <text class="TT">时间段: {{currentSlot.time}}</text>
        <view class="rooms-container">
          <view class="free-rooms">
            <text class="section-title">空闲会议室:</text>
            <block wx:for="{{currentSlot.freeRooms}}" wx:key="index">
              <button class="room-button" data-room="{{item}}" bindtap="goToBookingPage">{{item}}</button>
            </block>
          </view>
          <view class="occupied-rooms">
            <text class="section-title">占用会议室:</text>
            <block wx:for="{{currentSlot.occupiedRooms}}" wx:key="index">
              <button class="room-button" data-room="{{item}}" bindtap="goToBookingPage">{{item}}</button>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
