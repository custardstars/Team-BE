<view class="tabs">
  <view 
    class="tab {{selectedTab === 'all' ? 'active' : ''}}" 
    data-tab="all" 
    bindtap="onTabChange">
    全部订单
  </view>
  <view 
    class="tab {{selectedTab === 'reserved' ? 'active' : ''}}" 
    data-tab="reserved" 
    bindtap="onTabChange">
    已预约
  </view>
  <view 
    class="tab {{selectedTab === 'completed' ? 'active' : ''}}" 
    data-tab="completed" 
    bindtap="onTabChange">
    已完成
  </view>
  <view 
    class="tab {{selectedTab === 'subscribed' ? 'active' : ''}}" 
    data-tab="subscribed" 
    bindtap="onTabChange">
    已订阅
  </view>
</view>

<view class="order-list">
  <!-- 显示当前订单 -->
  <block wx:for="{{currentOrders}}" wx:key="index">
    <view class="order-item">
      <view class="cancel-btn" bindtap="cancelOrder" data-order="{{item}}">
        取消
      </view>
      <text>会议室: {{item.room_id}}</text>
      <text>日期: {{item.date}}</text>
      <text>时间段: {{item.slots}}</text>
      <text>预约时间: {{item.reserve_time}}</text>
      <text>手机号: {{item.phone}}</text> <!-- 新增字段：手机号 -->
      <text>主题: {{item.topic}}</text>  <!-- 新增字段：主题 -->
      <!-- <view wx:if="{{item.status === '已取消'}}" class="cancelled-status">已取消</view> -->
      <view class="cancelled-status">{{item.status}}</view>
    </view>
  </block>

  <!-- 如果没有订单 -->
  <view wx:if="{{currentOrders.length === 0}}">
    <text>暂无订单</text>
  </view>
</view>
