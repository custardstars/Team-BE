<view class="container">
  <!-- Tabs -->
  <view class="tabs">
    <button class="tab-button" bindtap="onTabChange" data-tab="all" 
      style="{{selectedTab === 'all' ? 'background-color: #ddd;' : ''}}">
      全部
    </button>
    <button class="tab-button" bindtap="onTabChange" data-tab="reserved" 
      style="{{selectedTab === 'reserved' ? 'background-color: #ddd;' : ''}}">
      已预约
    </button>
    <button class="tab-button" bindtap="onTabChange" data-tab="subscribed" 
      style="{{selectedTab === 'subscribed' ? 'background-color: #ddd;' : ''}}">
      已订阅
    </button>
    <button class="tab-button" bindtap="onTabChange" data-tab="completed" 
      style="{{selectedTab === 'completed' ? 'background-color: #ddd;' : ''}}">
      已完成
    </button>
  </view>

  <!-- 订单记录列表 -->
  <view class="order-list">
    <block wx:for="{{currentOrders}}" wx:key="id">
      <view class="order-item">
        <text>订单编号：{{item.order_id}}</text>
        <text>会议室：{{item.meeting_room}}</text>
        <text>日期：{{item.date}}</text>
        <text>时间段：{{item.time}}</text>
      </view>
    </block>
  </view>

  <!-- 调试：显示 currentOrders -->
  <view>{{currentOrders}}</view>
</view>
