<!--pages/booking/booking.wxml-->
<view class="container">
  <!-- 顶部日期栏 -->
  <view class="date-nav">
    <block wx:for="{{weekDates}}" wx:key="index">
      <view 
        class="date-item {{selectedDateIndex === index ? 'selected' : ''}}" 
        bindtap="onDateSelect" 
        data-index="{{index}}">
        <text>{{item.day}}</text>
        <text>{{item.date}}</text>
      </view>
    </block>
  </view>

  <!-- 时间段选择 -->
  <view class="time-section">
    <view class="time-grid">
      <block wx:for="{{timeSlots}}" wx:key="index">
        <view 
          class="time-item {{item.selected ? 'highlight' : ''}}" 
          bindtap="onTimeSlotSelect"
          data-index="{{index}}">
          <text>{{item.time}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 基础预约信息填写 -->
  <view class="form-section">
    <text class="section-title">基础预约信息</text>

    <!-- 会议室选择 -->
    <picker mode="selector" range="{{meetingRooms}}" bindchange="onMeetingRoomChange">
      <view class="form-item">
        <text>会议室</text>
        <text>{{selectedMeetingRoom}}</text>
      </view>
    </picker>

    <picker mode="selector" range="{{numberOptions}}" bindchange="onNumberChange">
      <view class="form-item">
        <text>会议人数</text>
        <text>{{number}}</text>
      </view>
    </picker>

    <!-- <view class="form-item">
      <text>会议人数</text>
      <input type="time" value="请输入人数" bindinput="onNumberInput" />
    </view> -->
    <view class="form-item">
      <text>会议主题</text>
      <input type="time" value="请输入主题" bindinput="onTopicInput" />
    </view>
    <view class="form-item">
      <text>联系方式</text>
      <input type="time" value="xxx-xxxx-xxxx" bindinput="onPhoneInput" />
    </view>
  </view>

  <!-- 确定按钮 -->
  <button class="confirm-btn" bindtap="onConfirm">确定</button>
</view>
