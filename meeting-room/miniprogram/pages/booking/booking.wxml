<!--pages/booking/booking.wxml-->
<view class="container">
  <!-- 顶部日期栏 -->
  <view class="date-nav">
    <block wx:for="{{weekDates}}" wx:key="index">
      <view 
        class="date-item {{selectedDateIndex === index ? 'selected' : ''}}" 
        bindtap="onDateSelect" 
        data-index="{{index}}">
        <text>{{item.day}}</text>
        <text>{{item.date}}</text>
      </view>
    </block>
  </view>

  <!-- 时间段选择 -->
  <view class="time-section">
    <view class="time-grid">
      <block wx:for="{{timeSlots}}" wx:key="index">
        <view 
          class="time-item {{item.status}}" 
          bindtap="onTimeSlotSelect"
          data-index="{{index}}">
          <text>{{item.time}}</text>
        </view>
      </block>
    </view>
  </view>
<!-- 添加帮助图标 -->
  <view class="help-icon" bindtap="onHelpClick">
    <image src="../../images/icons/avatar.png" mode="aspectFit" />
  </view>
    <!-- 添加帮助弹窗时的背景遮罩 -->
  <view class="mask-layer" wx:if="{{showHelpModal}}"></view>
  <!-- 弹窗内容 -->
  <view wx:if="{{showHelpModal}}" class="modal-overlay">
    <view class="modal-content">
      <text class="modal-title">预约帮助</text>
      <view class="modal-text">
        <text>(1).可以订阅他人预订的会议室，当他人取消预约时会自动帮你进行预约并发送通知\n</text>
        <text>(2).白色表示空闲的会议室；深灰表示被他人预约的会议室；绿色表示预约成功的会议室；蓝色表示订阅成功的会议室；浅灰表示想要预订的会议室；红色表示想要订阅的会议室\n</text>
        <text>(3).不能多次预约/订阅同一会议室的同一时间段\n</text>
      </view>
      <button class="modal-btn" bindtap="onCloseHelp">确定</button>
    </view>
  </view>
  <!-- 基础预约信息填写 -->
  <view class="form-section">
    <text class="section-title">基础预约信息</text>
    
    <!-- 会议室选择 -->
    <picker mode="selector" range="{{meetingRooms}}" bindchange="onMeetingRoomChange">
      <view class="form-item">
        <text>会议室</text>
        <text>{{meetingRoomSelected ? selectedMeetingRoom : '请选择'}}</text>
      </view>
    </picker>

    <picker mode="selector" range="{{numberOptions}}" bindchange="onNumberChange">
      <view class="form-item">
        <text>会议人数</text>
        <text>{{number}}</text>
      </view>
    </picker>

    <view class="form-item">
      <text>会议主题</text>
      <input type="time" value="请输入主题" bindinput="onTopicInput" />
    </view>
    <view class="form-item">
      <text>联系方式</text>
      <input type="time" value="xxx-xxxx-xxxx" bindinput="onPhoneInput" />
    </view>
  </view>

  <!-- 确定按钮 -->
  <button class="confirm-btn" bindtap="onConfirm">确认{{reserveOrSubscribe}}</button>
</view>

