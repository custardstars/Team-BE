/* 页面整体布局 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
}

/* 顶部日期导航栏 */
.date-nav {
  display: flex;
  justify-content: space-between; /* 两端对齐 */
  padding: 0; /* 去除 padding */
  margin: 0; /* 去除 margin */
  background-color: #f2f2f2;
}

.date-item {
  text-align: center;
  flex: 1; /* 平均分布每一项 */
  color: #666;
}

.date-item.selected {
  color: #ffffff;
  background-color: #007aff;
  font-weight: bold;
  border-radius: 5px;
}

.date-item text {
  display: block;
  font-size: 14px;
}

/* 时间段列表 */
.time-list {
  flex: 1;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f0f0;
  height: 25px;
}

.time {
  font-size: 16px;
  color: #333;
}

.status {
  font-size: 14px;
  color: #999;
}

/* 确定按钮 */
.confirm-button {
  padding: 20px;
  text-align: center;
}

button {
  background-color: #007aff;
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 16px;
  border: none;
}
